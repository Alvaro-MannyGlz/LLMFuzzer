# Local Ollama defaults
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3
LLM_FALLBACK_MODELS=qwen3.5,mistral,gemma

# Optional embedding model used by the knowledge base
LLM_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5

# Optional headers for OpenAI-compatible services that want them
LLM_SITE_URL=https://github.com/PrVrSs/circinus
LLM_SITE_NAME=circinus

# Other model options you can try locally or against a compatible endpoint:
# LLM_MODEL=qwen3.5
# LLM_MODEL=mistral
# LLM_MODEL=gemma2:9b
# LLM_MODEL=deepseek-r1:7b
# LLM_MODEL=llama3.2

# If you point Circinus at another OpenAI-compatible provider, update these too:
# LLM_API_KEY=your-api-key
# LLM_BASE_URL=https://example.com/v1